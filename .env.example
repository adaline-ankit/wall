# Only the provider selected in wall.yaml is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WALL_SMTP_USER=
WALL_SMTP_PASSWORD=
WALL_SYNC_PASSPHRASE=

# Required when exposing Margin beyond localhost. Any non-empty Basic Auth username works.
WALL_APP_PASSWORD=

# Optional write-only credential for a browser extension or inbound-email gateway. It can POST to
# the two capture routes but cannot read your Margin workspace. Use a long random value.
WALL_CAPTURE_TOKEN=

# Optional write-only scheduler credential. It can refresh the inbox but cannot read Margin or
# invoke an LLM provider. Use a long random value.
WALL_REFRESH_TOKEN=

# Ollama needs no key. Start Ollama locally and set:
# llm:
#   provider: ollama
#   model: llama3.2
#   base_url: http://localhost:11434
